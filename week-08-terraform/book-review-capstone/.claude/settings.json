{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(terraform apply *)",
      "Bash(terraform apply)",
      "Bash(terraform destroy *)",
      "Bash(terraform destroy)",
      "Bash(terraform -chdir=* apply*)",
      "Bash(terraform -chdir=* destroy*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/terraform.tfvars)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/terraform-check.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
