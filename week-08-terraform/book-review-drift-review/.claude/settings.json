{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(terraform apply *)",
      "Bash(terraform apply)",
      "Bash(terraform -chdir=* apply*)"
    ],
    "deny": [
      "Bash(terraform destroy *)",
      "Bash(terraform destroy)",
      "Bash(terraform -chdir=* destroy*)",
      "Bash(*-auto-approve*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/terraform.tfvars)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-apply-on-fail.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
